                                    <local:Icon Style="{StaticResource RowIcon}" Kind="Look" Width="18" Height="18"
                                                HorizontalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource TileLabel}" Text="Оформление"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Tile}" Margin="3,0" Click="PhoneSetRow_Click">
                                <StackPanel>
                                    <local:Icon Style="{StaticResource RowIcon}" Kind="Phone" Width="18" Height="18"
                                                HorizontalAlignment="Center"/>
                                    <TextBlock Style="{StaticResource TileLabel}" Text="Смартфон"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <Border Style="{StaticResource Card}" Margin="0,8,0,8">
                            <local:RowList>
                                <Button Style="{StaticResource RowButton}" Click="Lyrics_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Lines"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Текст песен"/>
                                        <local:Toggle x:Name="LyricsSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="LyricEffects_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Sparkle"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Эффекты текста"/>
                                        <local:Toggle x:Name="LyricEffectsSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="Rim_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Rim"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Цветной ободок"/>
                                        <local:Toggle x:Name="RimSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="AppVolume_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Mid"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Громкость приложения"/>
                                        <local:Toggle x:Name="AppVolumeSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                            </local:RowList>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <local:RowList>
                                <Button Style="{StaticResource RowButton}" Click="Network_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Wifi"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Уведомления о сети"/>
                                        <local:Toggle x:Name="NetworkSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="Mic_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Mic"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Уведомление о микрофоне"/>
                                        <local:Toggle x:Name="MicSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="Notices_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Note"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Уведомления Windows"/>
                                        <local:Toggle x:Name="NoticesSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="Fullscreen_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Expand"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Скрывать на полном экране"/>
                                        <local:Toggle x:Name="FullscreenSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="Autostart_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Windows"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Запускать с Windows"/>
                                        <local:Toggle x:Name="AutostartSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                            </local:RowList>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0">
                            <local:RowList>
                                <Button Style="{StaticResource RowButton}" Click="UpdateRow_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Update"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Обновление"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="UpdateText" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                            <local:Icon Style="{StaticResource RowChevron}" Margin="8,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </local:RowList>
                        </Border>
                        <Button x:Name="ExitButton" Style="{StaticResource ChipButton}" Height="38" Margin="2,9,2,0"
                                Background="#22FF453A" Foreground="{StaticResource Red}" FontSize="13"
                                FontWeight="SemiBold" Click="Exit_Click">
                            <StackPanel Orientation="Horizontal">
                                <local:Icon Kind="Power" Width="15" Height="15" Fill="{StaticResource Red}"
                                            VerticalAlignment="Center"/>
                                <TextBlock x:Name="ExitLabel" Text="Закрыть остров" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="PhoneView" Width="320" Height="300" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="PhoneHead" Style="{StaticResource BackButton}" Content="ТЕЛЕФОН"
                            Margin="10,8,10,4" Click="PhoneBack_Click"/>

                    <!-- The page is read as one flat list of rows, the look page's own way: a sign, a word, and what
                         the phone says of it at the right hand end. A row cut off by the pill's edge is gone, so the
                         rows are travelled under the pinned caption once the shelf of notices grows past the page. -->
                    <Border x:Name="PhoneScroll" Grid.Row="1" ClipToBounds="True">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="PhoneEdgeTop" Color="Black" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.06"/>
                                <GradientStop Color="Black" Offset="0.94"/>
                                <GradientStop x:Name="PhoneEdgeBottom" Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Canvas>
                            <local:RowList x:Name="PhoneBody" Width="300" Margin="10,0,10,0" VerticalAlignment="Top">
                                <local:RowList.RenderTransform>
                                    <TranslateTransform x:Name="PhoneMove"/>
                                </local:RowList.RenderTransform>
                                <Border x:Name="PairCard" Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,6"
                                        Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="Телефон просит пару" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Orange}"/>
                                        <TextBlock x:Name="PairWho" FontSize="12" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="PairPrint" FontSize="10.5" Foreground="{StaticResource Faint}"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        <Grid Margin="0,9,0,0">
                                            <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Left"
                                                    Width="110" Height="30" Background="#22FF453A"
                                                    Foreground="{StaticResource Red}" Content="Отклонить"
                                                    Click="PairNo_Click"/>
                                            <Button Style="{StaticResource ChipButton}" HorizontalAlignment="Right"
                                                    Width="110" Height="30" Background="#2230D158"
                                                    Foreground="{StaticResource Green}" FontWeight="SemiBold"
                                                    Content="Разрешить" Click="PairYes_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Grid Height="30" Margin="11,0">
                                    <local:Icon Style="{StaticResource RowIcon}" Kind="Phone"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Устройство"/>
                                    <TextBlock x:Name="PhoneDevice" FontSize="13" Foreground="{StaticResource Dim}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="185"/>
                                </Grid>
                                <Grid Height="30" Margin="11,0">
                                    <local:Icon Style="{StaticResource RowIcon}" Kind="Battery"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Заряд"/>
                                    <StackPanel x:Name="PhoneCharge" Orientation="Horizontal" HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <local:Battery x:Name="PhoneBatteryCell" Width="22" Height="12" VerticalAlignment="Center"/>
                                        <local:Digits x:Name="PhoneBattery" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                        <!-- a phone that has not spoken of its battery is said so, rather than left as an
                                             empty shell and a dash, which read as a figure that had gone wrong -->
                                        <TextBlock x:Name="PhoneBatteryNone" Text="нет данных" FontSize="12.5"
                                                   Foreground="{StaticResource Dim}" VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Height="30" Margin="11,0">
                                    <local:Icon Style="{StaticResource RowIcon}" Kind="Bell"/>
                                    <!-- the count and the chip are laid over this row's right side, so the word stops short
                                         of them rather than running under a two-digit one; the row's own left room is the
                                         sign's, and is said here rather than left to the style's, since a margin written
                                         on the row replaces the style's whole of it and would drop the word over its sign -->
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Уведомления" Margin="26,0,116,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border x:Name="PhoneNoticeCountPlate" Background="#1FFFFFFF" CornerRadius="9"
                                                Padding="7,1,7,2" Margin="0,0,7,0" VerticalAlignment="Center">
                                            <local:Digits x:Name="PhoneNoticeCount" FontSize="12"
                                                          Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                        </Border>
                                        <Button x:Name="PhoneNoticeAsk" Style="{StaticResource ChipButton}" Width="74" Height="22"
                                                FontSize="11.5" Margin="0" Content="Обновить" Click="PhoneNoticeAsk_Click"
                                                ToolTip="Переспросить полку уведомлений у телефона"/>
                                    </StackPanel>
                                </Grid>
                                <!-- The shelf: one plate per notice the phone is holding, and a page that is measured
                                     again whenever one of them unfolds. A shelf longer than the pill is scrolled the
                                     way every other page of this island is, its own end fading under the edge; a
                                     button that grew the page past the pill would only bury what it promised. The
                                     plates lay their own ground under the pointer, so this list is a plain stack: a
                                     band from the row list would light a plate twice over. -->
                                <StackPanel x:Name="PhoneNoticeRows" Margin="0" SizeChanged="PhoneShelf_SizeChanged"/>
                                <TextBlock x:Name="PhoneNoticeHint" FontSize="11.5" Foreground="{StaticResource Faint}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </local:RowList>
                        </Canvas>
                    </Border>
                </Grid>

                <Grid x:Name="PhoneSetView" Width="320" Height="400" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="PhoneSetBack" Style="{StaticResource BackButton}" Content="СМАРТФОН"
                            Margin="10,8,10,4" Click="SettingsBack_Click"/>
                    <Border x:Name="PhoneSetScroll" Grid.Row="1" ClipToBounds="True">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="PhoneSetEdgeTop" Color="Black" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.06"/>
                                <GradientStop Color="Black" Offset="0.94"/>
                                <GradientStop x:Name="PhoneSetEdgeBottom" Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Canvas>
                            <local:RowList x:Name="PhoneSetBody" Width="300" Margin="10,0,10,0" VerticalAlignment="Top">
                                <local:RowList.RenderTransform>
                                    <TranslateTransform x:Name="PhoneSetMove"/>
                                </local:RowList.RenderTransform>
                                <Button Style="{StaticResource RowButton}" Click="Bridge_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Phone"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Мост с телефоном"/>
                                        <local:Toggle x:Name="BridgeSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="BridgeKde_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Windows"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Протокол KDE Connect"/>
                                        <local:Toggle x:Name="BridgeKdeSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="PhoneNotices_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Note"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Уведомления с телефона"/>
                                        <local:Toggle x:Name="PhoneNoticesSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                                <!-- The section below goes the other way: what this machine says is said on the phone's
                                     own screen. A phone shows a notice a desktop sends it by a plugin its owner has to
                                     switch on, so the first of these answers itself with a saying the moment it is
                                     taken — the owner learns then whether the door is open, rather than waiting for the
                                     next notification to find out that it was never going anywhere. -->
                                <Button Style="{StaticResource RowButton}" Click="PhoneOutRow_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Bell"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Что уходит на телефон"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="PhoneOutText" Foreground="{StaticResource Dim}" FontSize="12"
                                                       MaxWidth="118" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <local:Icon x:Name="PhoneOutChevron" Style="{StaticResource RowChevron}" Margin="8,1,0,0"
                                                        RenderTransformOrigin="0.5,0.5">
                                                <local:Icon.RenderTransform>
                                                    <RotateTransform/>
                                                </local:Icon.RenderTransform>
                                            </local:Icon>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border x:Name="PhoneOutTiles" Height="0" Visibility="Collapsed" ClipToBounds="True"
                                        SizeChanged="Section_SizeChanged">
                                    <local:RowList Margin="0,0,0,6" Opacity="0">
                                        <Button Style="{StaticResource RowButton}" Click="PhoneAlerts_Click">
                                            <Grid>
                                                <local:Icon Style="{StaticResource RowIcon}" Kind="Bell"/>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="Уведомления ПК"/>
                                                <local:Toggle x:Name="PhoneAlertsSwitch" Style="{StaticResource RowSwitch}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource RowButton}" Click="PhoneTimer_Click">
                                            <Grid>
                                                <local:Icon Style="{StaticResource RowIcon}" Kind="Clock"/>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="Конец таймера"/>
                                                <local:Toggle x:Name="PhoneTimerSwitch" Style="{StaticResource RowSwitch}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource RowButton}" Click="PhoneClipboard_Click">
                                            <Grid>
                                                <local:Icon Style="{StaticResource RowIcon}" Kind="Clip"/>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="Копия"/>
                                                <local:Toggle x:Name="PhoneClipboardSwitch" Style="{StaticResource RowSwitch}"/>
                                            </Grid>
                                        </Button>
                                    </local:RowList>
                                </Border>
                                <Button Style="{StaticResource RowButton}" Click="CodeRow_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Tray"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Код подключения"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="PhoneUrl" Foreground="{StaticResource Dim}" FontSize="12"
                                                       MaxWidth="118" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <local:Icon x:Name="CodeChevron" Style="{StaticResource RowChevron}" Margin="8,1,0,0"
                                                        RenderTransformOrigin="0.5,0.5">
                                                <local:Icon.RenderTransform>
                                                    <RotateTransform/>
                                                </local:Icon.RenderTransform>
                                            </local:Icon>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border x:Name="CodeTiles" Height="0" Visibility="Collapsed" ClipToBounds="True"
                                        SizeChanged="Section_SizeChanged">
                                    <StackPanel Margin="0,2,0,8" Opacity="0">
                                        <Border x:Name="CodePlate" Width="172" Height="172" CornerRadius="12" Background="White"
                                                HorizontalAlignment="Center">
                                            <Image x:Name="PhoneCode" Width="156" Height="156" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                        </Border>
                                        <TextBlock x:Name="PhoneNote" FontSize="11" Foreground="{StaticResource Faint}"
                                                   TextAlignment="Center" TextWrapping="Wrap" Margin="14,9,14,0"/>
                                    </StackPanel>
                                </Border>
                            </local:RowList>
                        </Canvas>
                    </Border>
                </Grid>

                <Grid x:Name="LookView" Width="352" Height="340" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Button x:Name="LookBack" Style="{StaticResource BackButton}" Content="ОФОРМЛЕНИЕ"
                            Margin="10,8,10,4" Click="SettingsBack_Click"/>

                    <!-- The rows below scroll under their own caption once a section has been opened under them: the
                         fade at each end is the same one the shelf wears, since a row cut off by the pill's edge
                         reads as a row that is not there. And as on the shelf the list stands in a canvas of its own
                         and this border does the clipping, so a row that has scrolled out of the top goes under the
                         caption instead of over it. The canvas is what leaves the rows their full height: measured
                         against the short page, a stack folds the rows under the cut away instead of leaving them
                         below to be scrolled up. And since a canvas stretches nothing, the list names the width the
                         page has — rows left to their own width crowd their labels under the values they carry. -->
                    <Border x:Name="LookScroll" Grid.Row="1" ClipToBounds="True">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="LookEdgeTop" Color="Black" Offset="0"/>
                                <GradientStop Color="Black" Offset="0.06"/>
                                <GradientStop Color="Black" Offset="0.94"/>
                                <GradientStop x:Name="LookEdgeBottom" Color="Black" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                        <Canvas>
                            <local:RowList x:Name="LookBody" Width="332" Margin="10,0,10,0" VerticalAlignment="Top">
                                <local:RowList.RenderTransform>
                                    <TranslateTransform x:Name="LookMove"/>
                                </local:RowList.RenderTransform>
                                <Button x:Name="SizeRow" Style="{StaticResource RowButton}">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Size"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Размер"/>
                                        <local:Scrubber x:Name="SizeSlider" Style="{StaticResource RowSlider}"
                                                        Minimum="85" Maximum="130" Step="5" Changed="SizeSlider_Changed"/>
                                        <local:Digits x:Name="SizeText" Foreground="{StaticResource Dim}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="GapRow" Style="{StaticResource RowButton}">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Gap"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Отступ от края"/>
                                        <local:Scrubber x:Name="GapSlider" Style="{StaticResource RowSlider}"
                                                        Minimum="0" Maximum="24" Step="2" Changed="GapSlider_Changed"/>
                                        <local:Digits x:Name="GapText" Foreground="{StaticResource Dim}"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="PlaceRow" Style="{StaticResource RowButton}" Click="PlaceRow_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Pin"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Положение"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="PlaceText" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                            <local:Icon x:Name="PlaceChevron" Style="{StaticResource RowChevron}" Margin="8,1,0,0"
                                                        RenderTransformOrigin="0.5,0.5">
                                                <local:Icon.RenderTransform>
                                                    <RotateTransform/>
                                                </local:Icon.RenderTransform>
                                            </local:Icon>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border x:Name="PlaceTiles" Height="0" Visibility="Collapsed" ClipToBounds="True"
                                        SizeChanged="Section_SizeChanged">
                                    <local:RowList x:Name="PlaceRows" Margin="0,0,0,6" Opacity="0">
                                        <Button x:Name="EdgeRow" Style="{StaticResource RowButton}" Click="Edge_Click">
                                            <Grid>
                                                <local:Icon Style="{StaticResource RowIcon}" Kind="Edge"/>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="Край экрана"/>
                                                <local:Digits x:Name="EdgeText" Foreground="{StaticResource Dim}"
                                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="MonitorRow" Style="{StaticResource RowButton}" Click="Monitor_Click">
                                            <Grid>
                                                <local:Icon Style="{StaticResource RowIcon}" Kind="Windows"/>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="Экран"/>
                                                <local:Digits x:Name="MonitorText" Foreground="{StaticResource Dim}"
                                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="AnchorRow" Style="{StaticResource RowButton}" Click="Anchor_Click">
                                            <Grid>
                                                <local:Icon Style="{StaticResource RowIcon}" Kind="Gap"/>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="Привязка"/>
                                                <local:Segments x:Name="AnchorSegments" Style="{StaticResource RowSegments}"/>
                                            </Grid>
                                        </Button>
                                        <Button x:Name="AlongRow" Style="{StaticResource RowButton}">
                                            <Grid>
                                                <local:Icon Style="{StaticResource RowIcon}" Kind="Expand"/>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="Смещение вдоль"/>
                                                <local:Scrubber x:Name="AlongSlider" Style="{StaticResource RowSlider}"
                                                                Minimum="-100" Maximum="100" Step="8" Changed="AlongSlider_Changed"/>
                                                <local:Digits x:Name="AlongText" Foreground="{StaticResource Dim}"
                                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource RowButton}" Click="WorkArea_Click">
                                            <Grid>
                                                <local:Icon Style="{StaticResource RowIcon}" Kind="Size"/>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="Не залезать на панель"/>
                                                <local:Toggle x:Name="WorkSwitch" Style="{StaticResource RowSwitch}"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource RowButton}" Click="Drag_Click">
                                            <Grid>
                                                <local:Icon Style="{StaticResource RowIcon}" Kind="Tray"/>
                                                <TextBlock x:Name="DragText" Style="{StaticResource RowLabel}" Text="Переместить мышью"/>
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource RowButton}" Click="PlaceReset_Click">
                                            <Grid>
                                                <local:Icon Style="{StaticResource RowIcon}" Kind="Back"/>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="Сбросить"/>
                                            </Grid>
                                        </Button>
                                    </local:RowList>
                                </Border>
                                <Button x:Name="PulseRow" Style="{StaticResource RowButton}" Click="Pulse_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Pulse"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Пульс ободка"/>
                                        <TextBlock x:Name="PulseText" Foreground="{StaticResource Dim}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="Glass_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Sparkle"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Стекло"/>
                                        <local:Toggle x:Name="GlassSwitch" Style="{StaticResource RowSwitch}"/>
                                    </Grid>
                                </Button>
                                <!-- The glass has a strength of its own only while there is glass to weigh: the row
                                     stands under its switch while the switch is on and goes away with it, so the page
                                     never asks for a number that changes nothing. -->
                                <Border x:Name="FrostTiles" Height="0" Visibility="Collapsed" ClipToBounds="True"
                                        SizeChanged="Frost_SizeChanged">
                                    <local:RowList Margin="0,0,0,6" Opacity="0">
                                        <Button Style="{StaticResource RowButton}">
                                            <Grid>
                                                <local:Icon Style="{StaticResource RowIcon}" Kind="Drop"/>
                                                <TextBlock Style="{StaticResource RowLabel}" Text="Сила размытия"/>
                                                <local:Scrubber x:Name="FrostSlider" Style="{StaticResource RowSlider}"
                                                                Minimum="10" Maximum="100" Step="10"
                                                                Changed="FrostSlider_Changed"/>
                                                <local:Digits x:Name="FrostText" Foreground="{StaticResource Dim}"
                                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>
                                    </local:RowList>
                                </Border>
                                <Button Style="{StaticResource RowButton}" Click="Dots_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Bars"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Эквалайзер"/>
                                        <local:Segments x:Name="DotsSegments" Style="{StaticResource RowSegments}" Labels="Полоски|Матрица"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="SeekStyle_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Segments"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Полоса трека"/>
                                        <local:Segments x:Name="SeekStyleSegments" Style="{StaticResource RowSegments}" Labels="Сплошная|По строкам"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="SeekHover_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Bulge"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Под курсором"/>
                                        <local:Segments x:Name="SeekHoverSegments" Style="{StaticResource RowSegments}" Labels="Лупа|Строка|Волна"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource RowButton}" Click="BackdropRow_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Stars"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Фон плеера"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="BackdropText" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                            <local:Icon x:Name="BackdropChevron" Style="{StaticResource RowChevron}" Margin="8,1,0,0"
                                                        RenderTransformOrigin="0.5,0.5">
                                                <local:Icon.RenderTransform>
                                                    <RotateTransform/>
                                                </local:Icon.RenderTransform>
                                            </local:Icon>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border x:Name="BackdropTiles" Height="0" Visibility="Collapsed" ClipToBounds="True"
                                        SizeChanged="Section_SizeChanged">
                                    <UniformGrid x:Name="BackdropStrip" Rows="1" Height="64" Margin="6,2,6,6" VerticalAlignment="Top" Opacity="0">
                                        <RadioButton Style="{StaticResource LookTile}" Tag="Свечение" Click="BackdropTile_Click">
                                            <local:BackdropPreview Kind="Glow"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource LookTile}" Tag="Матрица" Click="BackdropTile_Click">
                                            <local:BackdropPreview Kind="Matrix"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource LookTile}" Tag="Звёзды" Click="BackdropTile_Click">
                                            <local:BackdropPreview Kind="Stars"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource LookTile}" Tag="Вместе" Click="BackdropTile_Click">
                                            <local:BackdropPreview Kind="MatrixAndStars"/>
                                        </RadioButton>
                                    </UniformGrid>
                                </Border>
                                <Button Style="{StaticResource RowButton}" Click="LyricChangeRow_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Lines"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Смена строки"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="LyricChangeText" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                            <local:Icon x:Name="LyricChangeChevron" Style="{StaticResource RowChevron}" Margin="8,1,0,0"
                                                        RenderTransformOrigin="0.5,0.5">
                                                <local:Icon.RenderTransform>
                                                    <RotateTransform/>
                                                </local:Icon.RenderTransform>
                                            </local:Icon>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border x:Name="LyricChangeTiles" Height="0" Visibility="Collapsed" ClipToBounds="True"
                                        SizeChanged="Section_SizeChanged">
                                    <UniformGrid x:Name="LyricChangeStrip" Rows="1" Height="64" Margin="6,2,6,6" VerticalAlignment="Top" Opacity="0">
                                        <RadioButton Style="{StaticResource LookTile}" Tag="Плавно" Click="LyricChangeTile_Click">
                                            <local:LyricPreview Change="Smooth"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource LookTile}" Tag="Волна" Click="LyricChangeTile_Click">
                                            <local:LyricPreview Change="Wave"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource LookTile}" Tag="Барабан" Click="LyricChangeTile_Click">
                                            <local:LyricPreview Change="Drum"/>
                                        </RadioButton>
                                    </UniformGrid>
                                </Border>
                                <Button Style="{StaticResource RowButton}" Click="HoverRow_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Pointer"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Наведение"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="HoverText" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                                            <local:Icon x:Name="HoverChevron" Style="{StaticResource RowChevron}" Margin="8,1,0,0"
                                                        RenderTransformOrigin="0.5,0.5">
                                                <local:Icon.RenderTransform>
                                                    <RotateTransform/>
                                                </local:Icon.RenderTransform>
                                            </local:Icon>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border x:Name="HoverTiles" Height="0" Visibility="Collapsed" ClipToBounds="True"
                                        SizeChanged="Section_SizeChanged">
                                    <UniformGrid x:Name="HoverStrip" Rows="1" Height="64" Margin="6,2,6,6" VerticalAlignment="Top" Opacity="0">
                                        <RadioButton Style="{StaticResource LookTile}" Tag="Диск" Click="HoverTile_Click">
                                            <local:HoverPreview Kind="Disc"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource LookTile}" Tag="Магнит" Click="HoverTile_Click">
                                            <local:HoverPreview Kind="Magnet"/>
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource LookTile}" Tag="Перетекание" Click="HoverTile_Click">
                                            <local:HoverPreview Kind="Flow"/>
                                        </RadioButton>
                                    </UniformGrid>
                                </Border>
                                <Button x:Name="FaceRow" Style="{StaticResource RowButton}" Click="FaceRow_Click">
                                    <Grid>
                                        <local:Icon Style="{StaticResource RowIcon}" Kind="Font"/>
                                        <TextBlock Style="{StaticResource RowLabel}" Text="Шрифты"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock x:Name="FontNameText" Foreground="{StaticResource Dim}" FontSize="12"
                                                       MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <local:Icon x:Name="FaceChevron" Style="{StaticResource RowChevron}" Margin="8,1,0,0"
                                                        RenderTransformOrigin="0.5,0.5">
                                                <local:Icon.RenderTransform>
                                                    <RotateTransform/>
                                                </local:Icon.RenderTransform>
                                            </local:Icon>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                                <Border x:Name="FontTiles" Height="0" Visibility="Collapsed" ClipToBounds="True"
                                        SizeChanged="Section_SizeChanged">
                                    <StackPanel Margin="0,0,0,6" Opacity="0">
                                        <UniformGrid x:Name="FaceStrip" Rows="1" Height="64" Margin="6,2,6,2" VerticalAlignment="Top"/>
                                        <local:RowList>
                                            <Button x:Name="FontScaleRow" Style="{StaticResource RowButton}">
                                                <Grid>
                                                    <local:Icon Style="{StaticResource RowIcon}" Kind="Size"/>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Размер букв"/>
                                                    <local:Scrubber x:Name="FontScaleSlider" Style="{StaticResource RowSlider}"
                                                                    Minimum="80" Maximum="160" Step="5" Changed="FontScaleSlider_Changed"/>
                                                    <local:Digits x:Name="FontScaleText" Foreground="{StaticResource Dim}"
                                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource RowButton}" Click="FontAdd_Click">
                                                <Grid>
                                                    <local:Icon Style="{StaticResource RowIcon}" Kind="Plus"/>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Загрузить файл…"/>
                                                </Grid>
                                            </Button>
                                            <Button Style="{StaticResource RowButton}" Click="FontFolder_Click">
                                                <Grid>
                                                    <local:Icon Style="{StaticResource RowIcon}" Kind="Tray"/>
                                                    <TextBlock Style="{StaticResource RowLabel}" Text="Открыть папку шрифтов"/>
                                                </Grid>
                                            </Button>
                                        </local:RowList>
                                    </StackPanel>
                                </Border>
                                <Grid Height="30" Margin="11,0">
                                    <local:Icon Style="{StaticResource RowIcon}" Kind="Drop"/>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Акцентный цвет" FontSize="13"/>
                                    <TextBlock x:Name="AccentText" FontSize="13" Foreground="{StaticResource Dim}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <UniformGrid x:Name="AccentStrip" Rows="1" Height="26" Margin="5,1,5,0">
                                    <RadioButton Style="{StaticResource Swatch}" Tag="Из обложки" Click="Accent_Click">
                                        <RadioButton.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FF375F" Offset="0"/>
                                                <GradientStop Color="#FFD60A" Offset="0.35"/>
                                                <GradientStop Color="#30D158" Offset="0.65"/>
                                                <GradientStop Color="#0A84FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </RadioButton.Background>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Swatch}" Background="#FFFFFF" Tag="Белый" Click="Accent_Click"/>
                                    <RadioButton Style="{StaticResource Swatch}" Background="#FF453A" Tag="Красный" Click="Accent_Click"/>
                                    <RadioButton Style="{StaticResource Swatch}" Background="#FF9F0A" Tag="Оранжевый" Click="Accent_Click"/>
                                    <RadioButton Style="{StaticResource Swatch}" Background="#FFD60A" Tag="Жёлтый" Click="Accent_Click"/>
                                    <RadioButton Style="{StaticResource Swatch}" Background="#30D158" Tag="Зелёный" Click="Accent_Click"/>
                                    <RadioButton Style="{StaticResource Swatch}" Background="#64D2FF" Tag="Голубой" Click="Accent_Click"/>
                                    <RadioButton Style="{StaticResource Swatch}" Background="#0A84FF" Tag="Синий" Click="Accent_Click"/>
                                    <RadioButton Style="{StaticResource Swatch}" Background="#BF5AF2" Tag="Фиолетовый" Click="Accent_Click"/>
                                    <RadioButton Style="{StaticResource Swatch}" Background="#FF375F" Tag="Розовый" Click="Accent_Click"/>
                                </UniformGrid>
                            </local:RowList>
                        </Canvas>
                    </Border>
                </Grid>

                <Grid x:Name="ShelfView" Width="380" Height="480" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="88"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="22" Margin="22,12,16,0" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Caption}" Text="ПОЛКА" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ChipButton}" Width="22" Height="22" Margin="0,0,6,0" Click="ShelfAdd_Click">
                                <local:Icon Kind="Plus" Width="12" Height="12" Fill="{StaticResource Dim}"/>
                            </Button>
                            <Button x:Name="ShelfClear" Style="{StaticResource ChipButton}" Height="22" Margin="0" FontSize="11"
                                    Click="ShelfClear_Click">
                                <TextBlock Text="Очистить" Margin="10,0" Foreground="{StaticResource Dim}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1">
                        <Rectangle x:Name="ShelfZone" Margin="14,6,14,6" RadiusX="16" RadiusY="16"
                                   Stroke="White" StrokeThickness="1.5" StrokeDashArray="3 2.5" Fill="#0AFFFFFF" Opacity="0"
                                   IsHitTestVisible="False"/>
                        <Button x:Name="ShelfHint" Style="{StaticResource PlainButton}" Margin="14,6,14,6" Click="ShelfAdd_Click"
                                MouseEnter="ShelfHint_MouseHover" MouseLeave="ShelfHint_MouseHover">
                            <StackPanel VerticalAlignment="Center">
                                <local:Icon Kind="Tray" Width="22" Height="22" Fill="{StaticResource Dim}"/>
                                <TextBlock x:Name="ShelfHintText" Text="Перетащите сюда файлы" FontSize="12" Foreground="{StaticResource Dim}"
                                           Margin="0,6,0,0" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ShelfHintMore" Text="или нажмите, чтобы выбрать" FontSize="11" Foreground="{StaticResource Faint}"
                                           Margin="0,1,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border x:Name="ShelfStrip" Margin="18,0,18,0" ClipToBounds="True">
                            <Border.OpacityMask>
                                <LinearGradientBrush MappingMode="Absolute" StartPoint="0,0" EndPoint="344,0">
                                    <GradientStop x:Name="ShelfEdgeLeft" Color="Black" Offset="0"/>
                                    <GradientStop Color="Black" Offset="0.05"/>
                                    <GradientStop Color="Black" Offset="0.95"/>
                                    <GradientStop x:Name="ShelfEdgeRight" Color="Black" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.OpacityMask>
                            <Canvas>
                                <StackPanel x:Name="ShelfTiles" Orientation="Horizontal" Margin="0,8,0,0">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="ShelfMove"/>
                                    </StackPanel.RenderTransform>
                                </StackPanel>
                            </Canvas>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Height="22" Margin="22,10,16,0" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Caption}" Text="БУФЕР ОБМЕНА" VerticalAlignment="Center"/>
                        <Button x:Name="ClipClear" Style="{StaticResource ChipButton}" Height="22" Margin="0" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" Click="ClipClear_Click">
                            <TextBlock Text="Очистить" Margin="10,0" Foreground="{StaticResource Dim}"/>
                        </Button>
                    </Grid>

                    <local:RowList x:Name="ClipRows" Grid.Row="3" Margin="10,6,10,0"/>
                    <TextBlock x:Name="ClipHint" Grid.Row="3" Text="Скопируй что-нибудь —&#10;оно появится здесь" FontSize="12.5"
                               Foreground="{StaticResource Faint}" TextAlignment="Center" TextWrapping="Wrap"
                               Margin="0,40,0,0" VerticalAlignment="Top" IsHitTestVisible="False"/>
                </Grid>

                <Grid x:Name="ClipToastView" Width="250" Height="34" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="208"/>
                    </Grid.ColumnDefinitions>
                    <local:Icon Kind="Clip" Width="17" Height="17" Fill="White"/>
                    <TextBlock x:Name="ClipToastText" Grid.Column="1" FontSize="12.5" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>

                <Canvas x:Name="PeekLayer"/>
            </Grid>

            <Canvas x:Name="Shared" Visibility="Collapsed" Opacity="0">
                <Grid x:Name="ArtSpot" Width="64" Height="64" MouseLeftButtonUp="Art_MouseLeftButtonUp">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ArtSize"/>
                            <TranslateTransform x:Name="ArtMove"/>
                        </TransformGroup>
                    </Grid.RenderTransform>
                    <Border Background="{StaticResource ArtPlaceholder}">
                        <local:Icon Kind="Note" Width="30" Height="30" Fill="{StaticResource Dim}"/>
                    </Border>
                    <local:Cover x:Name="Art" Radius="16"/>
                </Grid>
                <local:Equalizer x:Name="Eq" Bars="8" Few="5" Width="21" Height="16" IsHitTestVisible="False">
                    <local:Equalizer.RenderTransform>
                        <TranslateTransform x:Name="EqMove"/>
                    </local:Equalizer.RenderTransform>
                </local:Equalizer>
            </Canvas>
        </Grid>

        <Border x:Name="Bubble" Width="78" Height="34" CornerRadius="17" Visibility="Collapsed"
                Background="Transparent" Padding="1"
                HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0,0"
                MouseEnter="Bubble_MouseEnter" MouseLeave="Bubble_MouseLeave"
                MouseLeftButtonDown="Bubble_MouseLeftButtonDown" MouseLeftButtonUp="Bubble_MouseLeftButtonUp">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="BubbleScale"/>
                    <TranslateTransform x:Name="BubbleMove"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Grid x:Name="BubbleBody" ClipToBounds="True">
                <Grid x:Name="BubbleRecord" Width="76" HorizontalAlignment="Left">
                    <Ellipse x:Name="BubbleRecordDot" Width="9" Height="9" Fill="{StaticResource Red}"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <local:Digits x:Name="BubbleRecordText" Text="0:00" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Red}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
                <Grid x:Name="BubbleTimer" Width="76" HorizontalAlignment="Left">
                    <local:Ring x:Name="BubbleRing" Width="16" Height="16"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <local:Digits x:Name="BubbleText" Text="25:00" FontSize="12.5" FontWeight="SemiBold"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </Grid>
                <StackPanel x:Name="BubbleShelf" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,13,0">
                    <local:Icon Kind="Tray" Width="15" Height="15" VerticalAlignment="Center"/>
                    <local:Digits x:Name="BubbleShelfText" Text="0" FontSize="12.5" FontWeight="SemiBold"
                                  VerticalAlignment="Center" Margin="4,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</Window>
